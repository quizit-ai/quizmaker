# Copy this file to .env for local use. NEVER commit the real .env.
# On Render, add these same keys under Environment instead of using a file.

# Free key from https://aistudio.google.com/apikey (required)
GEMINI_API_KEY=your_key_here

# Optional: change the Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Password for the /admin panel (username can be anything)
ADMIN_PASSWORD=choose_a_strong_password

# Local port only. Render sets PORT automatically, so don't add it there.
PORT=3000
